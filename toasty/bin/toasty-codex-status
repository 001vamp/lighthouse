#!/usr/bin/env python3
"""Codex lifecycle input on stdin -> Toasty's shared session registry.

No stdout: status reporting must never affect permissions or continue a turn.
"""
import fcntl
import json
import os
import re
from pathlib import Path
import sys
import tempfile
import time
import uuid

from toastylib import in_desktop_app, t3_codex_thread, t3_thread, with_t3


def update(data):
    sid = data.get('thread-id') or data.get('session_id')
    # Kitty sessions are skipped, like Claude's: the dock reads those from their window title.
    if not isinstance(sid, str) or not sid or os.environ.get('KITTY_WINDOW_ID'):
        return
    # A turn with no transcript is one the app runs out of sight (e.g. ChatGPT's suggestions):
    # there's no thread to show or open.
    if 'transcript_path' in data and not data['transcript_path']:
        return
    event = data.get('hook_event_name') or data.get('type')
    states = {'SessionStart': 'ready', 'UserPromptSubmit': 'working', 'PermissionRequest': 'waiting',
              'PostToolUse': 'working', 'Stop': 'done',
              'agent-turn-complete': 'done', 'StopFailure': 'failed'}
    if event == 'StopFailure':
        detail = data.get('error_details') or data.get('last-assistant-message') or data.get('message') or ''
        if re.search(r'(?:usage|rate)[ -]?limit|(?:hit|reached|exceeded).{0,50}limit|limit.{0,50}(?:reached|exceeded)|quota', str(detail), re.I):
            states[event] = 'paused'
    if event == 'Interrupt':
        states[event] = 'paused'
    ended = event == 'SessionEnd'
    if not ended and event not in states:
        return
    runtime = os.environ.get('XDG_RUNTIME_DIR')
    if not runtime:
        raise RuntimeError('XDG_RUNTIME_DIR is unset')
    runtime = os.path.join(runtime, 'toasty')
    os.makedirs(runtime, mode=0o700, exist_ok=True)
    path = Path(runtime) / 'sessions.json'

    def write(edit):
        """Change sessions.json under its lock. `edit` changes the dict in place; False = no write."""
        with open(str(path) + '.lock', 'a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                sessions = json.loads(path.read_text())
            except FileNotFoundError:
                sessions = {}
            if not isinstance(sessions, dict):
                raise ValueError('session registry is not an object')
            if edit(sessions) is False:
                return
            temporary = None
            try:
                with tempfile.NamedTemporaryFile(mode='w', dir=runtime,
                        prefix='sessions.', delete=False) as output:
                    temporary = output.name
                    json.dump(sessions, output)
                os.replace(temporary, path)
            finally:
                if temporary and os.path.exists(temporary):
                    os.unlink(temporary)

    looked_up = {}

    def edit(sessions):
        if ended:
            if sid not in sessions:
                return False
            del sessions[sid]
        else:
            # Tool completions refresh active sessions without resurrecting paused
            # sessions or overwriting a finished turn.
            if event == 'PostToolUse' and sessions.get(sid, {}).get('state') not in ('waiting', 'working'):
                return False
            previous = sessions.get(sid, {})
            project = Path(data.get('cwd') or os.getcwd()).name or 'Codex'
            sessions[sid] = {**previous, 'agent': 'Codex', 'project': project,
                             'state': states[event], 'revision': uuid.uuid4().hex, 'time': int(time.time()),
                             'app': ''}
            if in_desktop_app():
                sessions[sid].update(app='chatgpt', open='codex://threads/' + sid)
            # A session T3 Code started opens in T3 and folds into its orchestrator's job.
            with_t3(sessions[sid], previous.get('t3'))
            looked_up['t3'] = previous.get('t3')
            if event == 'UserPromptSubmit' and (not previous.get('task') or previous.get('task', '').strip().lower() in ('hi', 'hello', 'ok', 'yes', 'continue', 'do tht', 'do that', 'do it')):
                sessions[sid]['task'] = data.get('prompt') if isinstance(data.get('prompt'), str) else ''
            elif event == 'SessionStart' and previous:
                sessions[sid]['state'] = previous.get('state', 'ready')
            sessions[sid]['reason'] = ('Interrupted' if event == 'Interrupt' else
                'Usage limit reached' if states[event] == 'paused' else
                'Could not finish; open the session for details' if states[event] == 'failed' else '')
    write(edit)

    # Look the T3 thread up once, after the state is written, so a slow lookup never holds
    # back (or lands after) a newer state.
    if ended or 't3' not in looked_up or looked_up['t3'] is not None \
            or event not in ('SessionStart', 'UserPromptSubmit', 'PostToolUse', 'Stop', 'agent-turn-complete'):
        return
    # Only T3's own record counts: T3CODE_THREAD_ID here would belong to whatever T3 session
    # launched this Codex, not to this session.
    thread = t3_codex_thread(sid)
    found = t3_thread(sid, True, thread) if thread else None
    if found is None:
        return

    def attach(sessions):
        if sid not in sessions or 't3' in sessions[sid]:
            return False
        with_t3(sessions[sid], found)
    write(attach)


def main():
    try:
        update(json.load(sys.stdin))
    except Exception as error:
        print(f'toasty-codex-status: {error}', file=sys.stderr)
    return 0


if __name__ == '__main__':
    sys.exit(main())
