#!/usr/bin/env python3
"""Codex `notify` program → Toasty toast. Codex passes one JSON argument.

In kitty the toast takes replies and typing goes back to that window. Anywhere else
(the ChatGPT/Codex desktop app) it's read-only, and clicking opens the exact thread.
Every run is logged, so we can tell which Codex frontends actually call this.
"""
import glob, json, os, re, subprocess, sys, time

from toastylib import in_desktop_app, other_app_sessions

NOTIFY = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'toasty-notify')
LOG = os.path.join(os.environ.get('XDG_STATE_HOME', os.path.expanduser('~/.local/state')),
                   'toasty', 'toasty.log')

RUNTIME = os.path.join(os.environ.get('XDG_RUNTIME_DIR') or f'/tmp/toasty-{os.getuid()}', 'toasty')

def saved_thread(thread):
    """Does Codex keep this thread? Turns the app runs out of sight (e.g. ChatGPT's suggestions)
    leave no rollout, and their thread can't be opened, so they get no toast."""
    home = os.environ.get('CODEX_HOME') or os.path.expanduser('~/.codex')
    return any(glob.glob(os.path.join(home, folder, '**', f'rollout-*-{glob.escape(thread)}.jsonl'), recursive=True)
               for folder in ('sessions', 'archived_sessions'))

def log(msg):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, 'a') as f:
            f.write(time.strftime('%F %T ') + 'codex-notify: ' + msg + '\n')
    except OSError:
        pass

try:
    payload = json.loads(sys.argv[-1])
    in_kitty = bool(os.environ.get('KITTY_WINDOW_ID') and os.environ.get('KITTY_LISTEN_ON'))
    thread = str(payload.get('thread-id') or '')
    log(f"type={payload.get('type')} thread={thread or '-'} kitty={in_kitty} parent={os.getppid()}")
    if payload.get('type') == 'agent-turn-complete' and thread and not saved_thread(thread):
        log(f'skipped: {thread} is not a saved thread')
    elif payload.get('type') == 'agent-turn-complete':
        subprocess.run([os.path.join(os.path.dirname(os.path.realpath(__file__)), 'toasty-codex-status')],
                       input=json.dumps(payload), text=True, timeout=3)
        project = os.path.basename(payload.get('cwd') or os.getcwd()) or 'Codex'
        text = str(payload.get('last-assistant-message') or '').strip()
        message = (text[:16000] + ('\n\nPreview limit reached. Open session for the full reply.' if len(text) > 16000 else '')) or 'Finished its turn.'
        cmd = [NOTIFY, '--agent', 'Codex', '--provider', 'OpenAI', '--kind', 'done', '--context', project,
               '--detach']
        if thread:
            cmd += ['--session', thread, '--event', 'completion']
        turn = payload.get('turn-id') or payload.get('turn_id')
        if turn:
            cmd += ['--revision', str(turn)]
        if in_kitty:
            cmd += ['--kitty', '--reply', '--skip-if-focused']
        elif in_desktop_app():
            # No supported way to reply into a desktop thread yet, so no reply box.
            cmd += ['--desktop-entry', 'chatgpt']
            if thread:
                cmd += ['--open', f'codex://threads/{thread}']
            if not other_app_sessions(thread, 'chatgpt'):
                cmd.append('--skip-if-focused')
        subprocess.run(cmd + [f'Done in {project}', message], stdin=subprocess.DEVNULL, timeout=10)
except Exception as e:
    log(f'error: {e}')
    print(f'toasty-codex-notify: {e}', file=sys.stderr)
sys.exit(0)
