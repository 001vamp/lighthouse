#!/usr/bin/env python3
"""Dismiss one unchanged dock report without affecting the agent session."""
import fcntl
import json
import os
from pathlib import Path
import sys
import tempfile


def main():
    sid, expected_json = sys.argv[1:]
    expected = json.loads(expected_json)
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR') or f'/tmp/toasty-{os.getuid()}') / 'toasty'
    path = runtime / 'sessions.json'
    with open(str(path) + '.lock', 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        sessions = json.loads(path.read_text())
        current = sessions.get(sid)
        if current is None:
            return
        if current != expected:
            return  # A newer report must remain visible.
        if current.get('state') not in ('ready', 'done', 'paused', 'failed', 'working', 'waiting'):
            raise ValueError('unknown dock state')
        del sessions[sid]
        temporary = None
        try:
            with tempfile.NamedTemporaryFile(mode='w', dir=runtime, prefix='sessions.', delete=False) as output:
                temporary = output.name
                json.dump(sessions, output)
            os.replace(temporary, path)
        finally:
            if temporary and os.path.exists(temporary):
                os.unlink(temporary)


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print(f'toasty-dismiss: {error}', file=sys.stderr)
        sys.exit(1)
